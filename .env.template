# =======================================================
# FICHIER TEMPLATE DE VARIABLES D'ENVIRONNEMENT (.env.template)
# Ce fichier définit les variables requises pour le projet DocuExtract Benin.
# Créez une copie nommée .env et remplacez les valeurs placeholder.
# =======================================================

# ------------------------------------
# 1. CONFIGURATION DE LA BASE DE DONNÉES POSTGRESQL (Locale/Ubuntu)
# ------------------------------------
# DB_HOST: L'adresse du serveur PostgreSQL (localhost pour Ubuntu natif)
DB_HOST=localhost
# DB_PORT: Le port par défaut de PostgreSQL
DB_PORT=5432
# DB_NAME: Le nom de la base de données créée pour le projet (docuextract_db)
DB_NAME=docuextract_db
# DB_USER: L'utilisateur admin par défaut sur une installation Ubuntu
DB_USER=postgres
# DB_PASSWORD: Le mot de passe défini pour l'utilisateur DB_USER.
# REMPLACEZ 'votre_mdp_db' par la valeur réelle (ex: ensai)
DB_PASSWORD=votre_mdp_db
api_key="votre_cle_api_google"


